<!DOCTYPE html>
<html lang="cs">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Motání hadic na čas</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>

<div class="container">

    <h1>🧯 Motání hadic na čas</h1>

    <div id="cas">00:00.00</div>

    <div class="buttons">
        <button id="start">START</button>
        <button id="stop">STOP</button>
        <button id="reset">RESET</button>
        <button id="save">ULOŽIT ČAS</button>
        <button id="clear">SMAZAT VŠE</button>
    </div>

    <div class="info">

        <div class="box">
            <h3>Nejlepší čas</h3>
            <div id="bestTime">--:--.--</div>
        </div>

        <div class="box">
            <h3>Počet pokusů</h3>
            <div id="count">0</div>
        </div>

        <div class="box">
            <h3>Průměr</h3>
            <div id="average">--:--.--</div>
        </div>

    </div>

    <table id="table">
        <thead>
            <tr>
                <th>#</th>
                <th>Čas</th>
                <th>Datum</th>
            </tr>
        </thead>

        <tbody id="results"></tbody>

    </table>

</div>

<script src="script.js"></script>

</body>
</html>
*{
    margin:0;
    padding:0;
    box-sizing:border-box;
}

body{
    font-family:Arial,Helvetica,sans-serif;
    background:#ececec;
    padding:20px;
}

.container{
    max-width:900px;
    margin:auto;
    background:#fff;
    border-radius:12px;
    padding:20px;
    box-shadow:0 0 15px rgba(0,0,0,.15);
}

h1{
    text-align:center;
    margin-bottom:20px;
}

#cas{
    text-align:center;
    font-size:64px;
    font-weight:bold;
    margin:25px 0;
    color:#222;
}

.buttons{
    display:flex;
    flex-wrap:wrap;
    justify-content:center;
    gap:10px;
    margin-bottom:25px;
}

button{
    padding:12px 20px;
    font-size:17px;
    border:none;
    border-radius:8px;
    cursor:pointer;
    transition:.2s;
}

button:hover{
    transform:scale(1.05);
}

#start{background:#28a745;color:#fff;}
#stop{background:#dc3545;color:#fff;}
#reset{background:#007bff;color:#fff;}
#save{background:#ff9800;color:#fff;}
#clear{background:#555;color:#fff;}

.info{
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(180px,1fr));
    gap:15px;
    margin-bottom:25px;
}

.box{
    background:#f7f7f7;
    border-radius:10px;
    padding:15px;
    text-align:center;
    border:1px solid #ddd;
}

.box h3{
    margin-bottom:10px;
    font-size:18px;
}

.box div{
    font-size:28px;
    font-weight:bold;
    color:#0b7a0b;
}

table{
    width:100%;
    border-collapse:collapse;
}

th,td{
    border:1px solid #ccc;
    padding:10px;
    text-align:center;
}

th{
    background:#efefef;
}

tr:nth-child(even){
    background:#fafafa;
}

.best{
    background:#d4edda !important;
    font-weight:bold;
}

@media(max-width:700px){

    #cas{
        font-size:46px;
    }

    button{
        width:100%;
    }

}
const cas = document.getElementById("cas");

const start = document.getElementById("start");
const stop = document.getElementById("stop");
const reset = document.getElementById("reset");
const save = document.getElementById("save");
const clear = document.getElementById("clear");

const bestTime = document.getElementById("bestTime");
const count = document.getElementById("count");
const average = document.getElementById("average");
const results = document.getElementById("results");

let startTime = 0;
let elapsedTime = 0;
let timer = null;
let running = false;

let records = [];

cas.textContent = "00:00.00";
bestTime.textContent = "--:--.--";
count.textContent = "0";
average.textContent = "--:--.--";
