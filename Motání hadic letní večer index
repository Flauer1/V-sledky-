<!DOCTYPE html>
<html lang="cs">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Motání hadic na čas</title>

<style>

body{
    font-family:Arial,Helvetica,sans-serif;
    background:#f2f2f2;
    margin:0;
    padding:20px;
}

.container{
    max-width:1000px;
    margin:auto;
    background:white;
    padding:20px;
    border-radius:10px;
    box-shadow:0 0 10px rgba(0,0,0,.2);
}

h1{
    text-align:center;
    color:#c62828;
}

h2{
    text-align:center;
    color:#666;
}

table{
    width:100%;
    border-collapse:collapse;
    margin-top:20px;
}

th,td{
    border:1px solid #ccc;
    padding:10px;
}

th{
    background:#c62828;
    color:white;
}

input{
    width:100%;
    padding:8px;
    box-sizing:border-box;
}

button{
    padding:10px 20px;
    background:#2e7d32;
    color:white;
    border:none;
    cursor:pointer;
    border-radius:5px;
}

button:hover{
    background:#1b5e20;
}

</style>

</head>
<body>

<div class="container">

<h1>🚒 Letní večer SDH Lubina II Větřkovice</h1>
<h2>18. 7. 2026</h2>

<h3>Přidání soutěžícího</h3>

<table>

<tr>
<td width="180">Příjmení</td>
<td><input id="prijmeni"></td>
</tr>

<tr>
<td>Jméno</td>
<td><input id="jmeno"></td>
</tr>

<tr>
<td>Čas 1. pokusu</td>
<td><input id="cas"></td>
</tr>

<tr>
<td></td>
<td>
<button type="button" id="pridatPokus">
➕ Přidat další pokus
</button>
</td>
</tr>

<tbody id="dalsiPokusy"></tbody>

<tr>
<td colspan="2" style="text-align:center;">
<button id="pridat">
➕ Přidat soutěžícího
</button>
</td>
</tr>

</table>

<h3>Seznam soutěžících</h3>

<table>

<thead>

<tr>
<th>#</th>
<th>Příjmení</th>
<th>Jméno</th>
<th>Pokusy</th>
<th>Nejlepší čas</th>
</tr>

</thead>

<tbody id="vysledky">

</tbody>

</table>

</div>

<script>
let poradi = 1;

document.getElementById("pridat").addEventListener("click", function () {

    const prijmeni = document.getElementById("prijmeni").value.trim();
    const jmeno = document.getElementById("jmeno").value.trim();
    const cas = document.getElementById("cas").value.trim();

    if (prijmeni === "" || jmeno === "" || cas === "") {
        alert("Vyplň příjmení, jméno i čas.");
        return;
    }

    const radek = document.createElement("tr");

    radek.innerHTML = `
    <td>${poradi}</td>
    <td>${prijmeni}</td>
    <td>${jmeno}</td>
    <td>${cas}</td>
    <td>${cas}</td>
`;

    document.getElementById("vysledky").appendChild(radek);

    poradi++;

    document.getElementById("prijmeni").value = "";
    document.getElementById("jmeno").value = "";
    document.getElementById("cas").value = "";

    document.getElementById("prijmeni").focus();

});
</script>

</body>
</html>
