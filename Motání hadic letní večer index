const cas = document.getElementById("cas");
const rekord = document.getElementById("rekord");
const vysledky = document.getElementById("vysledky");

const start = document.getElementById("start");
const stop = document.getElementById("stop");
const reset = document.getElementById("reset");

let startCas = 0;
let uplynulyCas = 0;
let interval = null;
let bezi = false;

let seznamCasu = [];

cas.textContent = "00:00.00";
rekord.textContent = "--:--.--";
function zobrazCas() {

    let minuty = Math.floor(uplynulyCas / 60000);
    let sekundy = Math.floor((uplynulyCas % 60000) / 1000);
    let setiny = Math.floor((uplynulyCas % 1000) / 10);

    let text =
        String(minuty).padStart(2, "0") + ":" +
        String(sekundy).padStart(2, "0") + "." +
        String(setiny).padStart(2, "0");

    cas.textContent = text;

}
start.addEventListener("click", function () {

    if (bezi) return;

    startCas = Date.now() - uplynulyCas;

    interval = setInterval(function () {

        uplynulyCas = Date.now() - startCas;

        zobrazCas();

    }, 10);

    bezi = true;

});
stop.addEventListener("click", function () {

    if (!bezi) return;

    clearInterval(interval);

    bezi = false;

    seznamCasu.push(cas.textContent);

    const radek = document.createElement("tr");

    radek.innerHTML = `
        <td>${seznamCasu.length}</td>
        <td>${cas.textContent}</td>
    `;

    vysledky.appendChild(radek);

});
reset.addEventListener("click", function () {

    clearInterval(interval);

    bezi = false;

    uplynulyCas = 0;

    startCas = 0;

    zobrazCas();

});
function aktualizujRekord() {

    if (seznamCasu.length === 0) {

        rekord.textContent = "--:--.--";
        return;

    }

    let nejlepsi = seznamCasu[0];

    for (let i = 1; i < seznamCasu.length; i++) {

        if (seznamCasu[i] < nejlepsi) {

            nejlepsi = seznamCasu[i];

        }

    }

    rekord.textContent = nejlepsi;

}
function ulozData() {

    localStorage.setItem(
        "motaniHadic",
        JSON.stringify(seznamCasu)
    );

}
setInterval(function () {

    ulozData();

}, 1000);
function nactiData() {

    const data = localStorage.getItem("motaniHadic");

    if (data === null) return;

    seznamCasu = JSON.parse(data);

    vysledky.innerHTML = "";

    seznamCasu.forEach(function(casText, index) {

        const radek = document.createElement("tr");

        radek.innerHTML = `
            <td>${index + 1}</td>
            <td>${casText}</td>
        `;

        vysledky.appendChild(radek);

    });

    aktualizujRekord();

}

nactiData();
const smazat = document.getElementById("smazat");

smazat.addEventListener("click", function () {

    if (!confirm("Opravdu chceš smazat všechny výsledky?")) {
        return;
    }

    seznamCasu = [];

    vysledky.innerHTML = "";

    rekord.textContent = "--:--.--";

    localStorage.removeItem("motaniHadic");

});
function casNaSetiny(casText) {

    const casti = casText.split(":");
    const sekundy = casti[1].split(".");

    const minuty = parseInt(casti[0], 10);
    const sec = parseInt(sekundy[0], 10);
    const setiny = parseInt(sekundy[1], 10);

    return (minuty * 6000) + (sec * 100) + setiny;

}

function seradVysledky() {

    seznamCasu.sort(function(a, b) {
        return casNaSetiny(a) - casNaSetiny(b);
    });

    vysledky.innerHTML = "";

    seznamCasu.forEach(function(casText, index) {

        const radek = document.createElement("tr");

        radek.innerHTML = `
            <td>${index + 1}</td>
            <td>${casText}</td>
        `;

        vysledky.appendChild(radek);

    });

    aktualizujRekord();
    ulozData();

}
setInterval(function () {

    if (seznamCasu.length > 1) {
        seradVysledky();
    }

}, 500);
.nejlepsi{
    background:#c8f7c5;
    font-weight:bold;
    color:#0b7a0b;
}
function zvyrazniNejlepsi() {

    const radky = vysledky.querySelectorAll("tr");

    radky.forEach(function(radek) {
        radek.classList.remove("nejlepsi");
    });

    if (radky.length > 0) {
        radky[0].classList.add("nejlepsi");
    }

}
setInterval(function () {

    zvyrazniNejlepsi();

}, 500);
